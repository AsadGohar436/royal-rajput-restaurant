# ====================================================================
# RESTAURANT ORDERING PLATFORM - ENVIRONMENT VARIABLES
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Database Configuration
# Find these in your Supabase Project Settings -> API
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------------------------
# 2. Gmail SMTP Integration (Order Notifications)
# 
# How to get a Gmail App Password:
# 1. Enable 2-Step Verification in Google Account:
#    https://myaccount.google.com/security
# 2. Go to "App Passwords":
#    https://myaccount.google.com/apppasswords
# 3. Create a new App Password named "Restaurant App" (16 characters).
# 4. Paste that 16-character code below as GMAIL_APP_PASSWORD.
# --------------------------------------------------------------------
GMAIL_USER=restaurant.orders@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
RESTAURANT_NOTIFICATION_EMAIL=restaurant.orders@gmail.com
RESTAURANT_NAME="L'Osteria Bella"
